WIFI_SSID=YOUR_WIFI_SSID
WIFI_PASSWORD=YOUR_WIFI_PASSWORD

# Optional static address. Leave all five values empty to use DHCP.
ESP_STATIC_IP=
ESP_GATEWAY=
ESP_SUBNET=
ESP_DNS_PRIMARY=
ESP_DNS_SECONDARY=

TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID

# Configure Windows, Linux, or both. Leave both values empty to disable a target.

# Windows target
WINDOWS_MAC=
WINDOWS_IP=

# Linux target
LINUX_MAC=
LINUX_IP=

OTA_HOSTNAME=ESP32-WOL-Bot
OTA_PASSWORD=CHANGE_THIS_OTA_PASSWORD
OTA_PORT=3232

AUTO_WAKE_WINDOWS=false
AUTO_WAKE_LINUX=false
AUTO_WAKE_DELAY_SECONDS=10
